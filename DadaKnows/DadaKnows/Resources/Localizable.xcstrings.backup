    "• Subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period" : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Subscription automatically renews unless auto-renew is turned off at least 24-hours before the end of the current period"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• 订阅将自动续费，除非在当前周期结束前至少24小时关闭自动续费"
          }
        }
      }
    },
    "• Subscription takes effect immediately after activation" : {
